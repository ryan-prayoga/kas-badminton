{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "kok-badminton (dev)",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 8200,
      "autoPort": true
    },
    {
      "name": "kok-badminton (start)",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["start"],
      "port": 8200,
      "autoPort": true
    },
    {
      "name": "kok-v2 (dev)",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "v2", "run", "dev"],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "kok-v3-web (dev)",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "v3/web", "run", "dev"],
      "port": 5173,
      "autoPort": true
    },
    {
      "name": "kok-v3-api (dev)",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["-c", "cd v3/server && DATABASE_URL=postgresql://kok_app@localhost:5432/kok_v3 go run ./cmd/api"],
      "port": 8300,
      "autoPort": true
    }
  ]
}
